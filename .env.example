# =============================================================================
# GÖREV YÖNETİM SİSTEMİ — ORTAM DEĞİŞKENLERİ (ENVIRONMENT VARIABLES)
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri doldurun.
# ASLA gerçek şifreleri/anahtarları bu dosyaya yazmayın!
# =============================================================================

# ---------- UYGULAMA ----------
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# ---------- VERİTABANI (PostgreSQL) ----------
DB_NAME=gorev_yonetim
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------- JWT ----------
JWT_SECRET=

# ---------- SMTP (E-posta Gönderimi) ----------
SMTP_USER=
SMTP_PASS=

# ---------- ADMİN VARSAYILAN ŞİFRE ----------
ADMIN_DEFAULT_PASSWORD=

# ---------- LOGLAMA ----------
LOG_LEVEL=info
